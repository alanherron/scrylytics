// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model OracleInsight {
  id          String   @id @default(cuid())
  cardName    String
  patchVersion String?
  summary     String
  createdAt   DateTime @default(now())
}
